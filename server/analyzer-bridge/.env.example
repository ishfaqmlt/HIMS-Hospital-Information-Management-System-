# HIMS API Base Endpoint (Change to your actual server IP or domain)
HIMS_API_URL=http://localhost:8000/api

# Optional Sanctum Bearer Token if API authentication is enabled
HIMS_API_TOKEN=

# Default Fallback TCP Port to Listen for Incoming Machines (if not defined in DB)
DEFAULT_TCP_PORT=5100

# Polling Interval (in milliseconds) to sync machine settings from HIMS
SYNC_INTERVAL_MS=300000
