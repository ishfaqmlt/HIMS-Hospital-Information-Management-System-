{
  "name": "hims-analyzer-bridge",
  "version": "1.0.0",
  "description": "Production Node.js Laboratory Analyzer Socket & Serial Bridge Daemon for HIMS",
  "main": "bridge.js",
  "bin": "bridge.js",
  "scripts": {
    "start": "node bridge.js",
    "dev": "node --watch bridge.js",
    "build": "npx @yao-pkg/pkg . --targets node18-win-x64 --output HIMS-Analyzer-Bridge.exe"
  },
  "pkg": {
    "assets": [
      ".env.example",
      "astmParser.js",
      "hl7Parser.js"
    ]
  },
  "keywords": [
    "hims",
    "astm",
    "hl7",
    "laboratory",
    "analyzer",
    "rs232",
    "socket"
  ],
  "author": "Google Deepmind / HIMS Team",
  "license": "MIT",
  "dependencies": {
    "@serialport/parser-readline": "^10.5.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "serialport": "^12.0.0"
  }
}
